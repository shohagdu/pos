# Copy to .env for local development. Never commit .env.
APP_ENV=development

HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Comma-separated; empty = same-origin only (the Vite dev server proxies /api)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Docker Compose MySQL (infra/docker-compose.yml). Use TCP, not the unix socket.
DATABASE_URL=mysql://pos_app:pos_app_dev_only@127.0.0.1:3306/pos
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
RUN_MIGRATIONS_ON_START=true

LOG_FORMAT=pretty
RUST_LOG=info,pos_api=debug,sqlx=warn

# Public URL of the web app (links in invitations)
APP_URL=http://localhost:5173

# Auth. Generate a real secret with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_DAYS=30
# The dev server is plain HTTP; keep true everywhere else.
AUTH_COOKIE_SECURE=false
# Return OTP codes in API responses (no SMS gateway in development).
AUTH_EXPOSE_OTP=true
# Set true only behind Nginx, which overwrites X-Forwarded-For.
HTTP_TRUST_PROXY_HEADERS=false

# Worker
WORKER_TICK_SECS=3600
