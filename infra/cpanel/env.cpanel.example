# pos-api / pos-worker settings for the cPanel deployment. Upload as `.env`
# in the application root (next to app.js). Never commit the filled-in copy.

# `production` refuses to start until an SMS gateway is integrated; staging
# runs the same code with production-grade settings otherwise.
APP_ENV=staging

# Loopback port for pos-api behind app.js. Change it if the launcher log shows
# the API failing with "Address already in use" (another account has it).
API_INTERNAL_PORT=18080
CORS_ALLOWED_ORIGINS=
# app.js overwrites X-Forwarded-For with a single address.
HTTP_TRUST_PROXY_HEADERS=true

# cPanel > MySQL Databases. Names carry the account prefix (cpuser_pos).
# URL-encode special characters in the password (@ -> %40, # -> %23, : -> %3A).
DATABASE_URL=mysql://CPUSER_posapp:CHANGE_ME@localhost:3306/CPUSER_pos
# If the log shows "Access denied ... @'127.0.0.1'", cPanel only granted the
# user over the unix socket; connect through it instead:
#DATABASE_URL=mysql://CPUSER_posapp:CHANGE_ME@localhost/CPUSER_pos?socket=/var/lib/mysql/mysql.sock
# Shared hosting limits connections per account; keep this small.
DB_MAX_CONNECTIONS=5
DB_MIN_CONNECTIONS=1
DB_ACQUIRE_TIMEOUT_SECS=5
RUN_MIGRATIONS_ON_START=true

STORAGE_DIR=storage

RUST_LOG=info,sqlx=warn

APP_URL=https://jsaebike.com

# Generate locally: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_48_BYTE_SECRET
ACCESS_TOKEN_TTL_SECS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_SECURE=true
AUTH_EXPOSE_OTP=false

# Set to false to skip the background worker (saves memory on small plans).
RUN_WORKER=true
WORKER_TICK_SECS=3600
NOTIFY_TICK_SECS=120

# Email over SMTP (cPanel > Email Accounts > Connect Devices shows these).
#SMTP_HOST=mail.jsaebike.com
#SMTP_PORT=465
#SMTP_USERNAME=no-reply@jsaebike.com
#SMTP_PASSWORD=
#SMTP_FROM=JSA eBike POS <no-reply@jsaebike.com>
